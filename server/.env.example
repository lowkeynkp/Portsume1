# ── Portsume Server ──────────────────────────────────────────────
# Copy to .env and fill in. The server runs fully in "local" mode
# (in-memory store + deterministic mock AI) when SUPABASE_URL and
# OPENAI_API_KEY are absent, so you can develop without credentials.

NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Supabase (Postgres + Storage). Newer projects label these keys
# "publishable" and "secret"; either naming is accepted.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI Provider (OpenAI)
OPENAI_API_KEY=

# Session signing secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-secret

# Storage bucket for resumes
STORAGE_BUCKET=resumes

# Public subdomain root (e.g. portfolios.portsume.app)
PUBLIC_BASE_URL=http://localhost:8787
PUBLIC_SUBDOMAIN_ROOT=localhost

# Limits
MAX_UPLOAD_MB=15
